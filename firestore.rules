rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Credentials Collection (Hashed passwords)
    match /credentials/{userId} {
      allow read, write: if true;
    }

    // 3. Responses Collection (User submitted experiences)
    match /responses/{responseId} {
      allow read, write: if true;
    }

    // 4. Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
