{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with personal experience configurations and responses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authUid": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "isActive": { "type": "boolean" },
        "profiling": { "type": "string" },
        "personalText": { "type": "string" },
        "theme": { "type": "object" },
        "flowerConfig": { "type": "object" },
        "generatedFormulation": { "type": "object" },
        "userResponse": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "username", "name", "role", "isActive"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin registry record marking Ronald as administrator",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authUid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "role"]
    },
    "UserResponse": {
      "title": "UserResponse",
      "description": "Response submitted by user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authUid": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "response": { "type": "object" },
        "submittedAt": { "type": "string" }
      },
      "required": ["userId", "name", "username", "response", "submittedAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat session between user and admin with real-time presence and typing states",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "lastMessageText": { "type": "string" },
        "lastMessageAt": { "type": "string" },
        "adminInChat": { "type": "boolean" },
        "userInChat": { "type": "boolean" },
        "adminTyping": { "type": "boolean" },
        "userTyping": { "type": "boolean" },
        "adminLastSeen": { "type": "string" },
        "userLastSeen": { "type": "string" },
        "adminHeartbeat": { "type": "number" },
        "userHeartbeat": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message inside a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "userId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["user", "admin"] },
        "text": { "type": "string" },
        "isOriginalResponse": { "type": "boolean" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "chatId", "senderId", "senderRole", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User documents containing personal experience data"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin registry indicating authorized administrator UIDs"
    },
    "/responses/{responseId}": {
      "schema": { "$ref": "#/entities/UserResponse" },
      "description": "User submitted responses"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Chat metadata and summary"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Individual chat messages within a conversation"
    }
  }
}
